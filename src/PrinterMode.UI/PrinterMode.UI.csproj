<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <!-- Declared explicitly (plural, per the .NET SDK's self-contained-publish contract) so
         a plain "dotnet build" always restores the win-x64 asset graph too — without this,
         running "dotnet build" (no RID) before "dotnet publish -r win-x64" (what build.bat
         does) fails with NETSDK1047 ("doesn't have a target for 'net8.0-windows/win-x64'"),
         because the cached project.assets.json from the plain build never had that RID in it. -->
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>PrinterMode.UI</RootNamespace>
    <AssemblyName>PrinterMode</AssemblyName>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.3.0</Version>
    <Copyright>Copyright © 2024 PrinterMode</Copyright>
    <Company>PrinterMode</Company>
    <Product>PrinterMode</Product>
    <Description>Gerenciador de Impressoras Térmicas para Windows</Description>
  </PropertyGroup>

  <!-- UseWindowsForms adds implicit global usings for "System.Windows.Forms" AND
       "System.Drawing", both of which collide with WPF's own namespaces for shared names
       (Application/UserControl vs System.Windows.Forms; Color/Brushes vs
       System.Windows.Media) in every file in the project — not just the tray-icon code,
       which already fully qualifies System.Windows.Forms.*/System.Drawing.* and never
       needed either implicit using. Removing both fixes the ambiguity everywhere while
       keeping the WinForms assembly reference (needed for NotifyIcon) intact. -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PrinterMode.Core\PrinterMode.Core.csproj" />
    <ProjectReference Include="..\PrinterMode.DriverManager\PrinterMode.DriverManager.csproj" />
    <ProjectReference Include="..\PrinterMode.WindowsPrinter\PrinterMode.WindowsPrinter.csproj" />
    <ProjectReference Include="..\PrinterMode.NetworkDiscovery\PrinterMode.NetworkDiscovery.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Assets\icon.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- Copy Repository and Config folders to output -->
  <ItemGroup>
    <None Include="..\..\Repository\**\*" Link="Repository\%(RecursiveDir)%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\..\Config\**\*" Link="Config\%(RecursiveDir)%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
