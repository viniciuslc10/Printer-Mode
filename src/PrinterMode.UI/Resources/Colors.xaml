<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Dark Theme Palette (matches the approved mockup: dark navy + green accent) -->
  <Color x:Key="BgDark">#FF0E1116</Color>
  <Color x:Key="BgMedium">#FF1D222C</Color>
  <Color x:Key="BgLight">#FF10141B</Color>
  <Color x:Key="Accent">#FF3FCF8E</Color>
  <Color x:Key="AccentHover">#FF35B87D</Color>
  <Color x:Key="TextPrimary">#FFE7EAF0</Color>
  <Color x:Key="TextSecondary">#FFA8B0C0</Color>
  <Color x:Key="TextMuted">#FF7D8698</Color>
  <Color x:Key="Success">#FF3FCF8E</Color>
  <Color x:Key="Warning">#FFE0A23F</Color>
  <Color x:Key="Error">#FFE0605C</Color>
  <Color x:Key="CardBg">#FF171B23</Color>
  <Color x:Key="BorderColor">#FF2C3340</Color>

  <!-- Brushes -->
  <SolidColorBrush x:Key="BgDarkBrush" Color="{StaticResource BgDark}"/>
  <SolidColorBrush x:Key="BgMediumBrush" Color="{StaticResource BgMedium}"/>
  <SolidColorBrush x:Key="BgLightBrush" Color="{StaticResource BgLight}"/>
  <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource Accent}"/>
  <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHover}"/>
  <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimary}"/>
  <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondary}"/>
  <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMuted}"/>
  <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource Success}"/>
  <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource Warning}"/>
  <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource Error}"/>
  <SolidColorBrush x:Key="CardBgBrush" Color="{StaticResource CardBg}"/>
  <SolidColorBrush x:Key="BorderBrush2" Color="{StaticResource BorderColor}"/>

</ResourceDictionary>
