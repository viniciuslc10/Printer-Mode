<UserControl x:Class="PrinterMode.UI.Views.InstallDriverView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:PrinterMode.UI.Converters"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:core="clr-namespace:PrinterMode.Core.Enums;assembly=PrinterMode.Core"
             Background="Transparent">

  <UserControl.Resources>
    <conv:BoolToVisibilityConverter x:Key="BoolVis"/>
    <ObjectDataProvider x:Key="ConnectionTypes" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
      <ObjectDataProvider.MethodParameters>
        <x:Type TypeName="core:ConnectionType"/>
      </ObjectDataProvider.MethodParameters>
    </ObjectDataProvider>
  </UserControl.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <Grid Margin="30,24,30,24">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="20"/>
        <ColumnDefinition Width="340"/>
      </Grid.ColumnDefinitions>

      <!-- Left: Form -->
      <StackPanel Grid.Column="0">

        <!-- Header -->
        <StackPanel Margin="0,0,0,24">
          <TextBlock Text="Instalar Driver" FontSize="24" FontWeight="Bold"
                     Foreground="{StaticResource TextPrimaryBrush}"/>
          <TextBlock Text="Configure e instale o driver oficial do fabricante"
                     FontSize="13" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Driver Selection Card -->
        <Border Style="{StaticResource Card}" Margin="0,0,0,16">
          <StackPanel>
            <TextBlock Text="DRIVER" Style="{StaticResource SectionLabel}"/>

            <TextBlock Text="Fabricante" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
            <ComboBox ItemsSource="{Binding Manufacturers}"
                      SelectedItem="{Binding SelectedManufacturer}"
                      Margin="0,0,0,12"/>

            <TextBlock Text="Modelo" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
            <ComboBox ItemsSource="{Binding AvailableDrivers}"
                      SelectedItem="{Binding SelectedDriver}"
                      DisplayMemberPath="DisplayName"
                      IsEnabled="{Binding SelectedManufacturer, Converter={StaticResource BoolVis}}"
                      Margin="0,0,0,12"/>

            <TextBlock Text="Papel" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
            <ComboBox ItemsSource="{Binding AvailablePapers}"
                      SelectedItem="{Binding SelectedPaper}"
                      DisplayMemberPath="DisplayName"
                      IsEnabled="{Binding SelectedDriver, Converter={StaticResource BoolVis}}"/>
          </StackPanel>
        </Border>

        <!-- Connection Card -->
        <Border Style="{StaticResource Card}" Margin="0,0,0,16">
          <StackPanel>
            <TextBlock Text="CONEXÃO" Style="{StaticResource SectionLabel}"/>

            <TextBlock Text="Tipo de conexão" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
            <ComboBox ItemsSource="{Binding Source={StaticResource ConnectionTypes}}"
                      SelectedItem="{Binding SelectedConnectionType}"
                      Margin="0,0,0,12"/>

            <!-- USB -->
            <StackPanel Visibility="{Binding IsUsb, Converter={StaticResource BoolVis}}">
              <TextBlock Text="Porta USB" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
              <TextBox Text="{Binding PortName, UpdateSourceTrigger=PropertyChanged}"
                       ToolTip="Ex: USB001, USB002"/>
            </StackPanel>

            <!-- Serial -->
            <StackPanel Visibility="{Binding IsSerial, Converter={StaticResource BoolVis}}">
              <TextBlock Text="Porta COM" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
              <TextBox Text="{Binding PortName, UpdateSourceTrigger=PropertyChanged}"
                       ToolTip="Ex: COM1, COM2" Margin="0,0,0,12"/>

              <TextBlock Text="Velocidade (baud rate)" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
              <ComboBox ItemsSource="{Binding BaudRates}"
                        SelectedItem="{Binding BaudRate}"/>
            </StackPanel>

            <!-- Network -->
            <StackPanel Visibility="{Binding IsNetwork, Converter={StaticResource BoolVis}}">
              <TextBlock Text="Endereço IP" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
              <TextBox Text="{Binding IpAddress, UpdateSourceTrigger=PropertyChanged}"
                       ToolTip="Ex: 192.168.0.100" Margin="0,0,0,12"/>

              <TextBlock Text="Porta TCP" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
              <TextBox Text="{Binding NetworkPort, UpdateSourceTrigger=PropertyChanged}"
                       ToolTip="Ex: 9100"/>
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- Printer Name Card -->
        <Border Style="{StaticResource Card}" Margin="0,0,0,16">
          <StackPanel>
            <TextBlock Text="IMPRESSORA" Style="{StaticResource SectionLabel}"/>

            <TextBlock Text="Nome da impressora no Windows" FontSize="12"
                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
            <TextBox Text="{Binding PrinterName, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Nome que aparecerá em Dispositivos e Impressoras" Margin="0,0,0,12"/>

            <CheckBox Content="Definir como impressora padrão"
                      IsChecked="{Binding SetAsDefault}"/>
          </StackPanel>
        </Border>

        <!-- Actions -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Content="🖨 Teste de Impressão" Style="{StaticResource SecondaryButton}"
                  Command="{Binding TestPrintCommand}" Margin="0,0,8,0"
                  IsEnabled="{Binding IsSuccess}"/>
          <Button Style="{StaticResource PrimaryButton}"
                  Command="{Binding InstallCommand}"
                  IsEnabled="{Binding IsInstalling, Converter={StaticResource BoolVis}, ConverterParameter=invert}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="⊕  " Visibility="{Binding IsInstalling, Converter={StaticResource BoolVis}, ConverterParameter=invert}"/>
              <TextBlock Text="Instalando...  " Visibility="{Binding IsInstalling, Converter={StaticResource BoolVis}}"/>
              <TextBlock Text="Instalar Driver"/>
            </StackPanel>
          </Button>
        </StackPanel>
      </StackPanel>

      <!-- Right: Log Panel -->
      <Border Grid.Column="2" Style="{StaticResource Card}" Padding="16">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="LOG DE INSTALAÇÃO"
                     Style="{StaticResource SectionLabel}" Margin="0,0,0,12"/>

          <!-- Status Banner -->
          <Border DockPanel.Dock="Top" CornerRadius="6" Padding="12,8" Margin="0,0,0,12">
            <Border.Style>
              <Style TargetType="Border">
                <Setter Property="Background" Value="#22FFFFFF"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsSuccess}" Value="True">
                    <Setter Property="Background" Value="#224CAF50"/>
                  </DataTrigger>
                  <DataTrigger Binding="{Binding HasError}" Value="True">
                    <Setter Property="Background" Value="#22F44336"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Border.Style>
            <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" FontSize="12"
                       Foreground="{StaticResource TextPrimaryBrush}"/>
          </Border>

          <!-- Log entries -->
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding InstallLog}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="11" FontFamily="Consolas"
                             Foreground="{StaticResource TextSecondaryBrush}" Margin="0,1"/>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Grid>
  </ScrollViewer>
</UserControl>
