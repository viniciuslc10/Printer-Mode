<Window x:Class="PrinterMode.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:PrinterMode.UI.Converters"
        Title="PrinterMode"
        Height="620" Width="520"
        MinHeight="560" MinWidth="480"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgDarkBrush}"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanMinimize">

  <Window.Resources>
    <conv:BoolToVisibilityConverter x:Key="BoolVis"/>
    <conv:BoolToVisibilityConverter x:Key="InvertVis" Invert="True"/>
  </Window.Resources>

  <Border CornerRadius="12" ClipToBounds="True"
          BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1">
    <DockPanel Background="{StaticResource BgDarkBrush}">

      <!-- Title Bar -->
      <Border DockPanel.Dock="Top" Height="46"
              Background="{StaticResource BgMediumBrush}"
              MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
        <Grid>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0">
            <TextBlock Text="🖨" FontSize="16" Margin="0,0,8,0"/>
            <TextBlock Text="PrinterMode" FontSize="14" FontWeight="Bold"
                       Foreground="{StaticResource TextPrimaryBrush}"/>
            <TextBlock Text=" — Instalador de Impressoras" FontSize="12"
                       Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,8,0">
            <Button Style="{StaticResource IconButton}" Click="Minimize_Click">
              <TextBlock Text="─" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
            </Button>
            <Button Style="{StaticResource IconButton}" Click="Close_Click">
              <TextBlock Text="✕" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
            </Button>
          </StackPanel>
        </Grid>
      </Border>

      <!-- Main content -->
      <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,20,24,24">
        <StackPanel>

          <!-- Impressora -->
          <TextBlock Text="IMPRESSORA" Style="{StaticResource SectionLabel}"/>

          <Grid Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="12"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
              <TextBlock Text="Fabricante" FontSize="12"
                         Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
              <ComboBox ItemsSource="{Binding Manufacturers}"
                        SelectedItem="{Binding SelectedManufacturer}"/>
            </StackPanel>

            <StackPanel Grid.Column="2">
              <TextBlock Text="Modelo" FontSize="12"
                         Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
              <ComboBox ItemsSource="{Binding Models}"
                        SelectedItem="{Binding SelectedModel}"
                        DisplayMemberPath="Model"
                        IsEnabled="{Binding HasManufacturer}"/>
            </StackPanel>
          </Grid>

          <Border Height="1" Background="{StaticResource BorderBrush2}" Margin="0,16,0,16"/>

          <!-- Conexão -->
          <TextBlock Text="CONEXÃO" Style="{StaticResource SectionLabel}"/>

          <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
            <RadioButton Content="USB" IsChecked="{Binding ConnectionUsb}"
                         Foreground="{StaticResource TextPrimaryBrush}" FontSize="13"
                         Margin="0,0,24,0" VerticalContentAlignment="Center"/>
            <RadioButton Content="Rede (TCP/IP)" IsChecked="{Binding ConnectionNetwork}"
                         Foreground="{StaticResource TextPrimaryBrush}" FontSize="13"
                         Margin="0,0,24,0" VerticalContentAlignment="Center"/>
            <RadioButton Content="Serial (COM)" IsChecked="{Binding ConnectionSerial}"
                         Foreground="{StaticResource TextPrimaryBrush}" FontSize="13"
                         VerticalContentAlignment="Center"/>
          </StackPanel>

          <!-- Network fields -->
          <Grid Margin="0,0,0,12"
                Visibility="{Binding ShowNetworkFields, Converter={StaticResource BoolVis}}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="12"/>
              <ColumnDefinition Width="100"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
              <TextBlock Text="Endereço IP" FontSize="12"
                         Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
              <TextBox Text="{Binding IpAddress, UpdateSourceTrigger=PropertyChanged}"
                       Tag="Ex: 192.168.1.100"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Text="Porta" FontSize="12"
                         Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
              <TextBox Text="{Binding NetworkPort, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
          </Grid>

          <!-- Serial fields -->
          <StackPanel Margin="0,0,0,12"
                      Visibility="{Binding ShowSerialFields, Converter={StaticResource BoolVis}}">
            <TextBlock Text="Porta Serial" FontSize="12"
                       Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
            <ComboBox Text="{Binding ComPort}" IsEditable="True" Width="150" HorizontalAlignment="Left">
              <ComboBoxItem Content="COM1"/>
              <ComboBoxItem Content="COM2"/>
              <ComboBoxItem Content="COM3"/>
              <ComboBoxItem Content="COM4"/>
            </ComboBox>
          </StackPanel>

          <Border Height="1" Background="{StaticResource BorderBrush2}" Margin="0,4,0,16"/>

          <!-- Configuração -->
          <TextBlock Text="CONFIGURAÇÃO" Style="{StaticResource SectionLabel}"/>

          <StackPanel Margin="0,0,0,12">
            <TextBlock Text="Nome da impressora" FontSize="12"
                       Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
            <TextBox Text="{Binding PrinterName, UpdateSourceTrigger=PropertyChanged}"/>
          </StackPanel>

          <StackPanel Margin="0,0,0,12">
            <TextBlock Text="Tamanho do papel" FontSize="12"
                       Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
            <ComboBox ItemsSource="{Binding Papers}"
                      SelectedItem="{Binding SelectedPaper}"
                      DisplayMemberPath="DisplayName"/>
          </StackPanel>

          <CheckBox Content="Definir como impressora padrão"
                    IsChecked="{Binding SetAsDefault}"
                    Margin="0,0,0,20"/>

          <!-- Install Button -->
          <Button Style="{StaticResource PrimaryButton}"
                  Command="{Binding InstallCommand}"
                  Height="44" FontSize="14">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="Instalando..." FontSize="14"
                         Visibility="{Binding IsInstalling, Converter={StaticResource BoolVis}}"
                         Margin="0,0,8,0"/>
              <TextBlock Text="Instalar Impressora" FontSize="14"
                         Visibility="{Binding IsInstalling, Converter={StaticResource InvertVis}}"/>
            </StackPanel>
          </Button>

          <!-- Status Area -->
          <Border Margin="0,14,0,0" Padding="14,11" CornerRadius="8"
                  Background="#12FFFFFF"
                  BorderThickness="1"
                  BorderBrush="{StaticResource BorderBrush2}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="⏳" FontSize="13" Margin="0,0,8,0"
                         Visibility="{Binding IsInstalling, Converter={StaticResource BoolVis}}"
                         VerticalAlignment="Top"/>
              <TextBlock Text="✔" FontSize="13" Margin="0,0,8,0"
                         Foreground="{StaticResource SuccessBrush}"
                         Visibility="{Binding ShowSuccess, Converter={StaticResource BoolVis}}"
                         VerticalAlignment="Top"/>
              <TextBlock Text="✖" FontSize="13" Margin="0,0,8,0"
                         Foreground="{StaticResource ErrorBrush}"
                         Visibility="{Binding ShowError, Converter={StaticResource BoolVis}}"
                         VerticalAlignment="Top"/>
              <TextBlock Text="{Binding StatusText}" FontSize="12" TextWrapping="Wrap"
                         Foreground="{StaticResource TextSecondaryBrush}"
                         VerticalAlignment="Center"/>
            </StackPanel>
          </Border>

        </StackPanel>
      </ScrollViewer>
    </DockPanel>
  </Border>
</Window>
