<Window x:Class="PrinterMode.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:PrinterMode.UI.Views"
        xmlns:vm="clr-namespace:PrinterMode.UI.ViewModels"
        Title="PrinterMode — Gerenciador de Impressoras"
        Height="700" Width="1100"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgDarkBrush}"
        WindowStyle="None"
        AllowsTransparency="True">

  <Window.Resources>
    <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
      <views:DashboardView/>
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:InstallDriverViewModel}">
      <views:InstallDriverView/>
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:PrinterListViewModel}">
      <views:PrinterListView/>
    </DataTemplate>
  </Window.Resources>

  <Border CornerRadius="12" ClipToBounds="True">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="46"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="220"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- Title Bar -->
      <Border Grid.Row="0" Grid.ColumnSpan="2"
              Background="{StaticResource BgMediumBrush}"
              MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
        <Grid>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0">
            <TextBlock Text="🖨" FontSize="18" Margin="0,0,8,0"/>
            <TextBlock Text="PrinterMode" FontSize="15" FontWeight="Bold"
                       Foreground="{StaticResource TextPrimaryBrush}"/>
            <TextBlock Text=" v1.0" FontSize="12"
                       Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
          </StackPanel>

          <!-- Window Controls -->
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,8,0">
            <Button Style="{StaticResource IconButton}" Click="Minimize_Click" ToolTip="Minimizar">
              <TextBlock Text="─" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
            </Button>
            <Button Style="{StaticResource IconButton}" Click="Close_Click" ToolTip="Fechar">
              <TextBlock Text="✕" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
            </Button>
          </StackPanel>
        </Grid>
      </Border>

      <!-- Sidebar -->
      <Border Grid.Row="1" Grid.Column="0" Background="{StaticResource BgMediumBrush}">
        <DockPanel>
          <!-- Nav items -->
          <StackPanel DockPanel.Dock="Top" Margin="12,20,12,0" DataContext="{Binding}">
            <Button x:Name="BtnDashboard" Style="{StaticResource SidebarButton}"
                    Command="{Binding NavigateToDashboardCommand}">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="⌂" FontSize="16" Margin="0,0,10,0"/>
                <TextBlock Text="Dashboard"/>
              </StackPanel>
            </Button>

            <Button Style="{StaticResource SidebarButton}" Margin="0,4,0,0"
                    Command="{Binding NavigateToInstallCommand}">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="⊕" FontSize="16" Margin="0,0,10,0"/>
                <TextBlock Text="Instalar Driver"/>
              </StackPanel>
            </Button>

            <Button Style="{StaticResource SidebarButton}" Margin="0,4,0,0"
                    Command="{Binding NavigateToPrintersCommand}">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="☰" FontSize="16" Margin="0,0,10,0"/>
                <TextBlock Text="Impressoras"/>
              </StackPanel>
            </Button>
          </StackPanel>

          <!-- Bottom info -->
          <Border DockPanel.Dock="Bottom" Padding="16,12" BorderThickness="0,1,0,0"
                  BorderBrush="{StaticResource BorderBrush2}">
            <StackPanel>
              <TextBlock Text="Requer Administrador" FontSize="10"
                         Foreground="{StaticResource TextMutedBrush}"/>
              <TextBlock Text="Windows 10/11" FontSize="10"
                         Foreground="{StaticResource TextMutedBrush}"/>
            </StackPanel>
          </Border>
        </DockPanel>
      </Border>

      <!-- Main Content -->
      <Border Grid.Row="1" Grid.Column="1" Background="{StaticResource BgDarkBrush}">
        <ContentControl Content="{Binding CurrentView}" Margin="0"/>
      </Border>
    </Grid>
  </Border>
</Window>
