<Window x:Class="PrinterMode.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:PrinterMode.UI.Converters"
        Title="PrinterMode"
        Height="700" Width="530"
        MinHeight="620" MinWidth="480"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgDarkBrush}"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanMinimize">

  <Window.Resources>
    <conv:BoolToVisibilityConverter x:Key="BoolVis"/>
    <conv:BoolToVisibilityConverter x:Key="InvertVis" Invert="True"/>
    <conv:InvertBoolConverter x:Key="InvertBool"/>
    <conv:CountToVisibilityConverter x:Key="CountVis"/>

    <!-- RadioButton sem indicador padrão, usado nos cards de conexão.
         A raiz do template é Border Background="Transparent" para que cliques em
         qualquer ponto do card (não só na bolinha) selecionem a opção. -->
    <Style x:Key="ConnRadio" TargetType="RadioButton">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="VerticalAlignment" Value="Stretch"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <!-- Background="Transparent" garante hit-testing em toda a área do card -->
            <Border Background="Transparent">
              <StackPanel Margin="10,10,10,12">
                <Grid HorizontalAlignment="Left" Margin="0,0,0,8">
                  <Ellipse x:Name="Outer" Width="14" Height="14"
                           Stroke="{StaticResource BorderBrush2}"
                           StrokeThickness="1.5" Fill="Transparent"/>
                  <Ellipse x:Name="Inner" Width="7" Height="7"
                           Fill="#2563EB"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="Collapsed"/>
                </Grid>
                <ContentPresenter HorizontalAlignment="Center"/>
              </StackPanel>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Outer" Property="Stroke" Value="#2563EB"/>
                <Setter TargetName="Inner" Property="Visibility" Value="Visible"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="InfoHint" TargetType="Border">
      <Setter Property="Background" Value="#0A1B4F9E"/>
      <Setter Property="BorderBrush" Value="#251B4F9E"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="11,10"/>
    </Style>
  </Window.Resources>

  <Border CornerRadius="12" ClipToBounds="True"
          BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1">
    <DockPanel Background="{StaticResource BgDarkBrush}">

      <!-- Barra de título -->
      <Border DockPanel.Dock="Top" Height="46"
              Background="{StaticResource BgMediumBrush}"
              MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
        <Grid>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0">
            <TextBlock Text="🖨" FontSize="16" Margin="0,0,8,0"/>
            <TextBlock Text="PrinterMode" FontSize="14" FontWeight="Bold"
                       Foreground="{StaticResource TextPrimaryBrush}"/>
            <TextBlock Text=" — Instalador de Impressoras" FontSize="12"
                       Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,8,0">
            <Button Style="{StaticResource IconButton}" Click="Minimize_Click">
              <TextBlock Text="─" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
            </Button>
            <Button Style="{StaticResource IconButton}" Click="Close_Click">
              <TextBlock Text="✕" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
            </Button>
          </StackPanel>
        </Grid>
      </Border>

      <!-- Conteúdo principal -->
      <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,14,16,20">
        <StackPanel>

          <!-- ══ Card 1: Selecione sua impressora ══ -->
          <Border Style="{StaticResource Card}" Padding="16,14" Margin="0,0,0,10">
            <StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                <Border Width="24" Height="24" CornerRadius="12" Background="#1565C0"
                        Margin="0,0,10,0" VerticalAlignment="Center">
                  <TextBlock Text="1" Foreground="White" FontSize="12" FontWeight="Bold"
                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="Selecione sua impressora" FontSize="14" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
              </StackPanel>

              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="12"/>
                  <ColumnDefinition Width="132"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0">
                    <TextBlock Text="Fabricante" FontSize="11"
                               Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding Manufacturers}"
                              SelectedItem="{Binding SelectedManufacturer}"/>
                  </StackPanel>
                  <StackPanel Grid.Column="2">
                    <TextBlock Text="Modelo" FontSize="11"
                               Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding Models}"
                              SelectedItem="{Binding SelectedModel}"
                              IsEnabled="{Binding HasManufacturer}">
                      <ComboBox.ItemTemplate>
                        <DataTemplate>
                          <TextBlock Text="{Binding Model}" FontSize="13"/>
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                  </StackPanel>
                </Grid>

                <Border Grid.Column="2" Style="{StaticResource InfoHint}">
                  <StackPanel>
                    <TextBlock Text="ℹ" FontSize="14" Foreground="#4D80CC"/>
                    <TextBlock Text="Selecione o fabricante e o modelo da sua impressora."
                               FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                               TextWrapping="Wrap" Margin="0,5,0,0"/>
                  </StackPanel>
                </Border>
              </Grid>
            </StackPanel>
          </Border>

          <!-- ══ Card 2: Conexão ══ -->
          <Border Style="{StaticResource Card}" Padding="16,14" Margin="0,0,0,10">
            <StackPanel>
              <Grid Margin="0,0,0,14">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <Border Width="24" Height="24" CornerRadius="12" Background="#1565C0"
                          Margin="0,0,10,0">
                    <TextBlock Text="2" Foreground="White" FontSize="12" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Border>
                  <TextBlock Text="Como a impressora está conectada?" FontSize="14" FontWeight="SemiBold"
                             Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>
                <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                        Command="{Binding RefreshPortsCommand}"
                        Style="{StaticResource SecondaryButton}"
                        Height="28" Padding="10,0" FontSize="11">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="↺" FontSize="13" Margin="0,0,5,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Atualizar" VerticalAlignment="Center"/>
                  </StackPanel>
                </Button>
              </Grid>

              <!-- 4 cards de tipo de conexão -->
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="7"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="7"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="7"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- USB -->
                <Border Grid.Column="0" CornerRadius="8" BorderThickness="1.5" MinHeight="102">
                  <Border.Style>
                    <Style TargetType="Border">
                      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush2}"/>
                      <Setter Property="Background" Value="#05FFFFFF"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding ConnectionUsb}" Value="True">
                          <Setter Property="BorderBrush" Value="#2563EB"/>
                          <Setter Property="Background" Value="#0C2563EB"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Border.Style>
                  <RadioButton IsChecked="{Binding ConnectionUsb}" GroupName="ConnType"
                               Style="{StaticResource ConnRadio}">
                    <StackPanel HorizontalAlignment="Center">
                      <TextBlock Text="⬡" FontSize="20" Foreground="{StaticResource TextMutedBrush}"
                                 HorizontalAlignment="Center" Margin="0,0,0,5"/>
                      <TextBlock Text="USB" FontSize="12" FontWeight="SemiBold"
                                 Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                      <TextBlock Text="Conexão via" FontSize="10"
                                 Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center"/>
                      <TextBlock Text="cabo USB" FontSize="10"
                                 Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center"/>
                    </StackPanel>
                  </RadioButton>
                </Border>

                <!-- Rede -->
                <Border Grid.Column="2" CornerRadius="8" BorderThickness="1.5" MinHeight="102">
                  <Border.Style>
                    <Style TargetType="Border">
                      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush2}"/>
                      <Setter Property="Background" Value="#05FFFFFF"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding ConnectionNetwork}" Value="True">
                          <Setter Property="BorderBrush" Value="#2563EB"/>
                          <Setter Property="Background" Value="#0C2563EB"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Border.Style>
                  <RadioButton IsChecked="{Binding ConnectionNetwork}" GroupName="ConnType"
                               Style="{StaticResource ConnRadio}">
                    <StackPanel HorizontalAlignment="Center">
                      <TextBlock Text="⊕" FontSize="20" Foreground="{StaticResource TextMutedBrush}"
                                 HorizontalAlignment="Center" Margin="0,0,0,5"/>
                      <TextBlock Text="Rede (TCP/IP)" FontSize="12" FontWeight="SemiBold"
                                 Foreground="{StaticResource TextPrimaryBrush}"
                                 HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                      <TextBlock Text="Conexão pela" FontSize="10"
                                 Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center"/>
                      <TextBlock Text="rede" FontSize="10"
                                 Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center"/>
                    </StackPanel>
                  </RadioButton>
                </Border>

                <!-- Serial -->
                <Border Grid.Column="4" CornerRadius="8" BorderThickness="1.5" MinHeight="102">
                  <Border.Style>
                    <Style TargetType="Border">
                      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush2}"/>
                      <Setter Property="Background" Value="#05FFFFFF"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding ConnectionSerial}" Value="True">
                          <Setter Property="BorderBrush" Value="#2563EB"/>
                          <Setter Property="Background" Value="#0C2563EB"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Border.Style>
                  <RadioButton IsChecked="{Binding ConnectionSerial}" GroupName="ConnType"
                               Style="{StaticResource ConnRadio}">
                    <StackPanel HorizontalAlignment="Center">
                      <TextBlock Text="≡" FontSize="20" Foreground="{StaticResource TextMutedBrush}"
                                 HorizontalAlignment="Center" Margin="0,0,0,5"/>
                      <TextBlock Text="Serial (COM)" FontSize="12" FontWeight="SemiBold"
                                 Foreground="{StaticResource TextPrimaryBrush}"
                                 HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                      <TextBlock Text="Cabo serial" FontSize="10"
                                 Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center"/>
                      <TextBlock Text="(COM)" FontSize="10"
                                 Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center"/>
                    </StackPanel>
                  </RadioButton>
                </Border>

                <!-- Compartilhada -->
                <Border Grid.Column="6" CornerRadius="8" BorderThickness="1.5" MinHeight="102">
                  <Border.Style>
                    <Style TargetType="Border">
                      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush2}"/>
                      <Setter Property="Background" Value="#05FFFFFF"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding ConnectionShared}" Value="True">
                          <Setter Property="BorderBrush" Value="#2563EB"/>
                          <Setter Property="Background" Value="#0C2563EB"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Border.Style>
                  <RadioButton IsChecked="{Binding ConnectionShared}" GroupName="ConnType"
                               Style="{StaticResource ConnRadio}">
                    <StackPanel HorizontalAlignment="Center">
                      <TextBlock Text="⇄" FontSize="20" Foreground="{StaticResource TextMutedBrush}"
                                 HorizontalAlignment="Center" Margin="0,0,0,5"/>
                      <TextBlock Text="Compartilhada" FontSize="12" FontWeight="SemiBold"
                                 Foreground="{StaticResource TextPrimaryBrush}"
                                 HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                      <TextBlock Text="Impressora" FontSize="10"
                                 Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center"/>
                      <TextBlock Text="compartilhada" FontSize="10"
                                 Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center"/>
                    </StackPanel>
                  </RadioButton>
                </Border>
              </Grid>

              <!-- Porta USB (quando USB e portas detectadas) -->
              <StackPanel Margin="0,12,0,0"
                          Visibility="{Binding ShowUsbPortSelector, Converter={StaticResource BoolVis}}">
                <TextBlock Text="Porta USB" FontSize="11"
                           Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                <ComboBox ItemsSource="{Binding UsbPorts}" SelectedItem="{Binding SelectedUsbPort}">
                  <ComboBox.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding DisplayName}" FontSize="13"/>
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </StackPanel>

              <!-- Campos de Rede -->
              <Grid Margin="0,12,0,0"
                    Visibility="{Binding ShowNetworkFields, Converter={StaticResource BoolVis}}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="12"/>
                  <ColumnDefinition Width="100"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                  <TextBlock Text="Endereço IP" FontSize="11"
                             Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                  <TextBox Text="{Binding IpAddress, UpdateSourceTrigger=PropertyChanged}"
                           Tag="Ex: 192.168.1.100"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <TextBlock Text="Porta" FontSize="11"
                             Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                  <TextBox Text="{Binding NetworkPort, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
              </Grid>

              <!-- Campos Serial -->
              <StackPanel Margin="0,12,0,0"
                          Visibility="{Binding ShowSerialFields, Converter={StaticResource BoolVis}}">
                <TextBlock Text="Porta Serial" FontSize="11"
                           Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                <ComboBox ItemsSource="{Binding ComPorts}" SelectedItem="{Binding SelectedComPort}">
                  <ComboBox.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding DisplayName}" FontSize="13"/>
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </StackPanel>

              <!-- Campos Compartilhada -->
              <StackPanel Margin="0,12,0,0"
                          Visibility="{Binding ShowSharedFields, Converter={StaticResource BoolVis}}">
                <TextBlock Text="Computador ou IP do host" FontSize="11"
                           Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <TextBox Grid.Column="0"
                           Text="{Binding SharedHost, UpdateSourceTrigger=PropertyChanged}"
                           Tag="Ex: DESKTOP-PC ou 192.168.1.50"/>
                  <Button Grid.Column="2"
                          Command="{Binding SearchSharedPrintersCommand}"
                          IsEnabled="{Binding IsSearchingShared, Converter={StaticResource InvertBool}}"
                          Padding="12,0" Height="34">
                    <Button.Style>
                      <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                        <Setter Property="Content" Value="🔍 Buscar"/>
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsSearchingShared}" Value="True">
                            <Setter Property="Content" Value="Buscando..."/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Button.Style>
                  </Button>
                </Grid>

                <!-- Seleção do compartilhamento descoberto ou entrada manual -->
                <TextBlock FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,10,0,4"
                           Text="Impressora encontrada — selecione e clique em Instalar"
                           Visibility="{Binding HasSharedPrinters, Converter={StaticResource BoolVis}}"/>
                <TextBlock FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,10,0,4"
                           Text="Nome do compartilhamento — digite manualmente se souber"
                           Visibility="{Binding HasSharedPrinters, Converter={StaticResource InvertVis}}"/>

                <!-- ComboBox não-editável quando há impressoras descobertas -->
                <ComboBox ItemsSource="{Binding SharedPrinterList}"
                          SelectedItem="{Binding SelectedSharedPrinter, Mode=TwoWay}"
                          FontSize="13"
                          Visibility="{Binding HasSharedPrinters, Converter={StaticResource BoolVis}}"/>

                <!-- TextBox para entrada manual quando nenhuma foi descoberta -->
                <Grid Visibility="{Binding HasSharedPrinters, Converter={StaticResource InvertVis}}">
                  <TextBox Text="{Binding SharedPrinterName, UpdateSourceTrigger=PropertyChanged}"
                           FontSize="13"/>
                  <TextBlock Text="Ex: IMPRESSORA ou HP_LaserJet"
                             Foreground="{StaticResource TextMutedBrush}"
                             FontSize="13" Margin="12,0,0,0"
                             VerticalAlignment="Center" IsHitTestVisible="False">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding SharedPrinterName}" Value="">
                            <Setter Property="Visibility" Value="Visible"/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                </Grid>
                <TextBlock FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                           Margin="0,4,0,0" TextWrapping="Wrap"
                           Visibility="{Binding HasSharedPrinters, Converter={StaticResource InvertVis}}"
                           Text="Clique em 'Buscar' para encontrar automaticamente, ou insira o nome do compartilhamento."/>
              </StackPanel>

            </StackPanel>
          </Border>

          <!-- ══ Card 3: Configurações ══ -->
          <Border Style="{StaticResource Card}" Padding="16,14" Margin="0,0,0,12">
            <StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                <Border Width="24" Height="24" CornerRadius="12" Background="#1565C0"
                        Margin="0,0,10,0" VerticalAlignment="Center">
                  <TextBlock Text="3" Foreground="White" FontSize="12" FontWeight="Bold"
                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="Configurações da impressora" FontSize="14" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
              </StackPanel>

              <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="12"/>
                  <ColumnDefinition Width="132"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0">
                    <TextBlock Text="Nome da impressora" FontSize="11"
                               Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding PrinterName, UpdateSourceTrigger=PropertyChanged}"/>
                  </StackPanel>
                  <StackPanel Grid.Column="2">
                    <TextBlock Text="Tamanho do papel" FontSize="11"
                               Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding Papers}" SelectedItem="{Binding SelectedPaper}">
                      <ComboBox.ItemTemplate>
                        <DataTemplate>
                          <TextBlock Text="{Binding DisplayName}" FontSize="13"/>
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                  </StackPanel>
                </Grid>

                <Border Grid.Column="2" Style="{StaticResource InfoHint}">
                  <StackPanel>
                    <TextBlock Text="ℹ" FontSize="14" Foreground="#4D80CC"/>
                    <TextBlock Text="Você poderá alterar essas configurações depois nas preferências."
                               FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                               TextWrapping="Wrap" Margin="0,5,0,0"/>
                  </StackPanel>
                </Border>
              </Grid>

              <CheckBox IsChecked="{Binding SetAsDefault}">
                <StackPanel Margin="4,0,0,0">
                  <TextBlock Text="Definir como impressora padrão no Windows"
                             FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"/>
                  <TextBlock Text="A impressora será usada como padrão para todos os sistemas."
                             FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                             Margin="0,2,0,0"/>
                </StackPanel>
              </CheckBox>
            </StackPanel>
          </Border>

          <!-- Botão Instalar -->
          <Button Style="{StaticResource PrimaryButton}"
                  Command="{Binding InstallCommand}"
                  Height="46" FontSize="14" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="🖨" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"
                         Visibility="{Binding IsInstalling, Converter={StaticResource InvertVis}}"/>
              <TextBlock Text="⏳" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"
                         Visibility="{Binding IsInstalling, Converter={StaticResource BoolVis}}"/>
              <TextBlock Text="Instalar Impressora" FontSize="14" VerticalAlignment="Center"
                         Visibility="{Binding IsInstalling, Converter={StaticResource InvertVis}}"/>
              <TextBlock Text="Instalando..." FontSize="14" VerticalAlignment="Center"
                         Visibility="{Binding IsInstalling, Converter={StaticResource BoolVis}}"/>
            </StackPanel>
          </Button>

          <!-- Status -->
          <Border Padding="14,11" CornerRadius="8"
                  Background="#0CFFFFFF" BorderThickness="1"
                  BorderBrush="{StaticResource BorderBrush2}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="⏳" FontSize="13" Margin="0,0,8,0"
                         Foreground="{StaticResource TextMutedBrush}"
                         Visibility="{Binding IsInstalling, Converter={StaticResource BoolVis}}"
                         VerticalAlignment="Top"/>
              <TextBlock Text="✔" FontSize="13" Margin="0,0,8,0"
                         Foreground="{StaticResource SuccessBrush}"
                         Visibility="{Binding ShowSuccess, Converter={StaticResource BoolVis}}"
                         VerticalAlignment="Top"/>
              <TextBlock Text="✖" FontSize="13" Margin="0,0,8,0"
                         Foreground="{StaticResource ErrorBrush}"
                         Visibility="{Binding ShowError, Converter={StaticResource BoolVis}}"
                         VerticalAlignment="Top"/>
              <TextBlock Text="{Binding StatusText}" FontSize="12" TextWrapping="Wrap"
                         Foreground="{StaticResource TextSecondaryBrush}"
                         VerticalAlignment="Center"/>
            </StackPanel>
          </Border>

        </StackPanel>
      </ScrollViewer>
    </DockPanel>
  </Border>
</Window>
