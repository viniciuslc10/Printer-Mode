<Window x:Class="PrinterMode.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:PrinterMode.UI.Converters"
        Title="PrinterMode"
        Height="700" Width="530"
        MinHeight="500" MinWidth="480"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgDarkBrush}"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResize">

  <Window.Resources>
    <conv:BoolToVisibilityConverter x:Key="BoolVis"/>
    <conv:BoolToVisibilityConverter x:Key="InvertVis" Invert="True"/>
    <conv:InvertBoolConverter x:Key="InvertBool"/>
    <conv:CountToVisibilityConverter x:Key="CountVis"/>

    <!-- RadioButton sem indicador padrão, usado nos cards de conexão.
         A raiz do template é Border Background="Transparent" para que cliques em
         qualquer ponto do card (não só na bolinha) selecionem a opção. -->
    <Style x:Key="ConnRadio" TargetType="RadioButton">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="VerticalAlignment" Value="Stretch"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <!-- Background="Transparent" garante hit-testing em toda a área do card -->
            <Border Background="Transparent">
              <StackPanel Margin="10,10,10,12">
                <Grid HorizontalAlignment="Left" Margin="0,0,0,8">
                  <Ellipse x:Name="Outer" Width="14" Height="14"
                           Stroke="{StaticResource BorderBrush2}"
                           StrokeThickness="1.5" Fill="Transparent"/>
                  <Ellipse x:Name="Inner" Width="7" Height="7"
                           Fill="#3FCF8E"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="Collapsed"/>
                </Grid>
                <ContentPresenter HorizontalAlignment="Center"/>
              </StackPanel>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Outer" Property="Stroke" Value="#3FCF8E"/>
                <Setter TargetName="Inner" Property="Visibility" Value="Visible"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="InfoHint" TargetType="Border">
      <Setter Property="Background" Value="#0A3FCF8E"/>
      <Setter Property="BorderBrush" Value="#253FCF8E"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="11,10"/>
    </Style>
  </Window.Resources>

  <Border CornerRadius="12" ClipToBounds="True"
          BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1">
    <DockPanel Background="{StaticResource BgDarkBrush}">

      <!-- Barra de título -->
      <Border DockPanel.Dock="Top" Height="46"
              Background="{StaticResource BgMediumBrush}"
              MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
        <Grid>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0">
            <Ellipse Width="8" Height="8" Margin="0,0,9,0" VerticalAlignment="Center">
              <Ellipse.Style>
                <Style TargetType="Ellipse">
                  <Setter Property="Fill" Value="{StaticResource SuccessBrush}"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding ShowNoTargetsFound}" Value="True">
                      <Setter Property="Fill" Value="{StaticResource WarningBrush}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding ShowTargetPicker}" Value="True">
                      <Setter Property="Fill" Value="{StaticResource WarningBrush}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding ShowError}" Value="True">
                      <Setter Property="Fill" Value="{StaticResource ErrorBrush}"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Ellipse.Style>
            </Ellipse>
            <TextBlock Text="🖨" FontSize="16" Margin="0,0,8,0"/>
            <TextBlock Text="PrinterMode" FontSize="14" FontWeight="Bold"
                       Foreground="{StaticResource TextPrimaryBrush}"/>
            <TextBlock Text=" — Instalador de Impressoras" FontSize="12"
                       Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
            <TextBlock x:Name="VersionText" FontSize="11" Margin="8,0,0,0"
                       Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,8,0">
            <Button Style="{StaticResource IconButton}" Click="Minimize_Click">
              <TextBlock Text="─" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
            </Button>
            <Button Style="{StaticResource IconButton}" Click="Maximize_Click" ToolTip="Maximizar/Restaurar">
              <TextBlock Text="☐" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
            </Button>
            <Button Style="{StaticResource IconButton}" Click="Close_Click">
              <TextBlock Text="✕" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
            </Button>
          </StackPanel>
        </Grid>
      </Border>

      <!-- Conteúdo principal -->
      <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,14,16,20">
        <StackPanel>

          <!-- ══ Painel único: Instalar impressora (estilo do mockup — um card contínuo) ══ -->
          <Border Style="{StaticResource Card}" Padding="20,18" Margin="0,0,0,12">
            <StackPanel>

              <!-- ══ PASSO 1: só marca/modelo (mockup) ══ -->
              <StackPanel Visibility="{Binding ShowSelectStep, Converter={StaticResource BoolVis}}">
                <TextBlock Text="PASSO 1 DE 1" FontSize="11" FontWeight="SemiBold"
                           Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,14"
                           Typography.Capitals="AllSmallCaps"/>

                <Grid Margin="0,0,0,4">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0">
                    <TextBlock Text="Fabricante" FontSize="11"
                               Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding Manufacturers}"
                              SelectedItem="{Binding SelectedManufacturer}"/>
                  </StackPanel>
                  <StackPanel Grid.Column="2">
                    <TextBlock Text="Modelo" FontSize="11"
                               Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding Models}"
                              SelectedItem="{Binding SelectedModel}"
                              IsEnabled="{Binding HasManufacturer}">
                      <ComboBox.ItemTemplate>
                        <DataTemplate>
                          <TextBlock Text="{Binding Model}" FontSize="13"/>
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                  </StackPanel>
                </Grid>
              </StackPanel>

              <!-- ══ PASSO 2: conexão + configurações + confirmação ══ -->
              <StackPanel Visibility="{Binding ShowDetailStep, Converter={StaticResource BoolVis}}">

                <Grid Margin="0,0,0,14">
                  <TextBlock Text="{Binding SelectedModel.DisplayName}" FontSize="13" FontWeight="SemiBold"
                             Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                  <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                          Command="{Binding BackToSelectCommand}"
                          Style="{StaticResource SecondaryButton}"
                          Height="26" Padding="10,0" FontSize="11"
                          Content="← Trocar impressora"/>
                </Grid>

                <TextBlock Text="CONEXÃO DA IMPRESSORA" FontSize="11" FontWeight="SemiBold"
                           Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,10"
                           Typography.Capitals="AllSmallCaps"
                           Visibility="{Binding ShowManualConnection, Converter={StaticResource BoolVis}}"/>

                <!-- Estado procurando -->
                <Border CornerRadius="10" Background="#0C3FCF8E" BorderBrush="#2E3FCF8E"
                        BorderThickness="1" Padding="14,13"
                        Visibility="{Binding IsDetecting, Converter={StaticResource BoolVis}}">
                  <StackPanel Orientation="Horizontal">
                    <Border Width="34" Height="34" CornerRadius="17" Background="#1A3FCF8E"
                            Margin="0,0,12,0" VerticalAlignment="Top">
                      <TextBlock Text="⏳" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel>
                      <TextBlock Text="Procurando sua impressora..." FontSize="13" FontWeight="SemiBold"
                                 Foreground="{StaticResource TextPrimaryBrush}"/>
                      <TextBlock Text="Verificando USB, portas seriais e a rede local. Leva só alguns segundos."
                                 FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                    </StackPanel>
                  </StackPanel>
                </Border>

                <!-- Estado: mais de uma opção encontrada -->
                <Border CornerRadius="10" Background="#0C3FCF8E" BorderBrush="#2E3FCF8E"
                        BorderThickness="1" Padding="14,13"
                        Visibility="{Binding ShowTargetPicker, Converter={StaticResource BoolVis}}">
                  <StackPanel>
                    <StackPanel Orientation="Horizontal">
                      <Border Width="34" Height="34" CornerRadius="17" Background="#1A3FCF8E"
                              Margin="0,0,12,0" VerticalAlignment="Center">
                        <TextBlock Text="🔀" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                      </Border>
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Encontramos mais de uma opção" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="Selecione abaixo e clique em Instalar para confirmar."
                                   FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                      </StackPanel>
                    </StackPanel>

                    <ListBox ItemsSource="{Binding DetectedTargets}"
                             SelectedItem="{Binding SelectedTarget}"
                             Margin="0,12,0,0" BorderThickness="0" Background="Transparent">
                      <ListBox.ItemTemplate>
                        <DataTemplate>
                          <Border CornerRadius="8" Background="#14FFFFFF" Padding="11,9" Margin="0,0,0,6">
                            <StackPanel>
                              <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold"
                                         Foreground="{StaticResource TextPrimaryBrush}"/>
                              <TextBlock Text="{Binding Subtitle}" FontSize="11"
                                         Foreground="{StaticResource TextMutedBrush}"/>
                            </StackPanel>
                          </Border>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                  </StackPanel>
                </Border>

                <!-- Estado: nada encontrado -->
                <Border CornerRadius="10" Background="#0CE0A23F" BorderBrush="#2EE0A23F"
                        BorderThickness="1" Padding="14,13"
                        Visibility="{Binding ShowNoTargetsFound, Converter={StaticResource BoolVis}}">
                  <StackPanel Orientation="Horizontal">
                    <Border Width="34" Height="34" CornerRadius="17" Background="#1AE0A23F"
                            Margin="0,0,12,0" VerticalAlignment="Top">
                      <TextBlock Text="⚠" FontSize="15" Foreground="#E0A23F" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel>
                      <TextBlock Text="Não encontramos automaticamente" FontSize="13" FontWeight="SemiBold"
                                 Foreground="{StaticResource TextPrimaryBrush}"/>
                      <TextBlock Text="Verifique se a impressora está ligada e conectada, ou clique em Instalar novamente para tentar de novo."
                                 FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                    </StackPanel>
                  </StackPanel>
                </Border>

                <Button Command="{Binding UseManualConnectionCommand}"
                        Style="{StaticResource SecondaryButton}"
                        HorizontalAlignment="Left" Margin="0,10,0,0"
                        Height="27" Padding="10,0" FontSize="11.5"
                        Visibility="{Binding ShowManualConnection, Converter={StaticResource InvertVis}}"
                        Content="Selecionar manualmente"/>

              <!-- ══ Modo manual: fluxo original (USB/Rede/Serial/Compartilhada escolhidos à mão) ══ -->
              <StackPanel Visibility="{Binding ShowManualConnection, Converter={StaticResource BoolVis}}">
              <Button Command="{Binding UseAutomaticConnectionCommand}"
                      Style="{StaticResource SecondaryButton}"
                      HorizontalAlignment="Left" Margin="0,0,0,10"
                      Height="26" Padding="10,0" FontSize="11"
                      Content="← Voltar para detecção automática"/>

              <!-- 4 cards de tipo de conexão -->
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="7"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="7"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="7"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- USB -->
                <Border Grid.Column="0" CornerRadius="8" BorderThickness="1.5" MinHeight="102">
                  <Border.Style>
                    <Style TargetType="Border">
                      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush2}"/>
                      <Setter Property="Background" Value="#05FFFFFF"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding ConnectionUsb}" Value="True">
                          <Setter Property="BorderBrush" Value="#3FCF8E"/>
                          <Setter Property="Background" Value="#0C3FCF8E"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Border.Style>
                  <RadioButton IsChecked="{Binding ConnectionUsb}" GroupName="ConnType"
                               Style="{StaticResource ConnRadio}">
                    <StackPanel HorizontalAlignment="Center">
                      <TextBlock Text="⬡" FontSize="20" Foreground="{StaticResource TextMutedBrush}"
                                 HorizontalAlignment="Center" Margin="0,0,0,5"/>
                      <TextBlock Text="USB" FontSize="12" FontWeight="SemiBold"
                                 Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                      <TextBlock Text="Conexão via" FontSize="10"
                                 Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center"/>
                      <TextBlock Text="cabo USB" FontSize="10"
                                 Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center"/>
                    </StackPanel>
                  </RadioButton>
                </Border>

                <!-- Rede -->
                <Border Grid.Column="2" CornerRadius="8" BorderThickness="1.5" MinHeight="102">
                  <Border.Style>
                    <Style TargetType="Border">
                      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush2}"/>
                      <Setter Property="Background" Value="#05FFFFFF"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding ConnectionNetwork}" Value="True">
                          <Setter Property="BorderBrush" Value="#3FCF8E"/>
                          <Setter Property="Background" Value="#0C3FCF8E"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Border.Style>
                  <RadioButton IsChecked="{Binding ConnectionNetwork}" GroupName="ConnType"
                               Style="{StaticResource ConnRadio}">
                    <StackPanel HorizontalAlignment="Center">
                      <TextBlock Text="⊕" FontSize="20" Foreground="{StaticResource TextMutedBrush}"
                                 HorizontalAlignment="Center" Margin="0,0,0,5"/>
                      <TextBlock Text="Rede (TCP/IP)" FontSize="12" FontWeight="SemiBold"
                                 Foreground="{StaticResource TextPrimaryBrush}"
                                 HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                      <TextBlock Text="Conexão pela" FontSize="10"
                                 Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center"/>
                      <TextBlock Text="rede" FontSize="10"
                                 Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center"/>
                    </StackPanel>
                  </RadioButton>
                </Border>

                <!-- Serial -->
                <Border Grid.Column="4" CornerRadius="8" BorderThickness="1.5" MinHeight="102">
                  <Border.Style>
                    <Style TargetType="Border">
                      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush2}"/>
                      <Setter Property="Background" Value="#05FFFFFF"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding ConnectionSerial}" Value="True">
                          <Setter Property="BorderBrush" Value="#3FCF8E"/>
                          <Setter Property="Background" Value="#0C3FCF8E"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Border.Style>
                  <RadioButton IsChecked="{Binding ConnectionSerial}" GroupName="ConnType"
                               Style="{StaticResource ConnRadio}">
                    <StackPanel HorizontalAlignment="Center">
                      <TextBlock Text="≡" FontSize="20" Foreground="{StaticResource TextMutedBrush}"
                                 HorizontalAlignment="Center" Margin="0,0,0,5"/>
                      <TextBlock Text="Serial (COM)" FontSize="12" FontWeight="SemiBold"
                                 Foreground="{StaticResource TextPrimaryBrush}"
                                 HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                      <TextBlock Text="Cabo serial" FontSize="10"
                                 Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center"/>
                      <TextBlock Text="(COM)" FontSize="10"
                                 Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center"/>
                    </StackPanel>
                  </RadioButton>
                </Border>

                <!-- Compartilhada -->
                <Border Grid.Column="6" CornerRadius="8" BorderThickness="1.5" MinHeight="102">
                  <Border.Style>
                    <Style TargetType="Border">
                      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush2}"/>
                      <Setter Property="Background" Value="#05FFFFFF"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding ConnectionShared}" Value="True">
                          <Setter Property="BorderBrush" Value="#3FCF8E"/>
                          <Setter Property="Background" Value="#0C3FCF8E"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Border.Style>
                  <RadioButton IsChecked="{Binding ConnectionShared}" GroupName="ConnType"
                               Style="{StaticResource ConnRadio}">
                    <StackPanel HorizontalAlignment="Center">
                      <TextBlock Text="⇄" FontSize="20" Foreground="{StaticResource TextMutedBrush}"
                                 HorizontalAlignment="Center" Margin="0,0,0,5"/>
                      <TextBlock Text="Compartilhada" FontSize="12" FontWeight="SemiBold"
                                 Foreground="{StaticResource TextPrimaryBrush}"
                                 HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                      <TextBlock Text="Impressora" FontSize="10"
                                 Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center"/>
                      <TextBlock Text="compartilhada" FontSize="10"
                                 Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center"/>
                    </StackPanel>
                  </RadioButton>
                </Border>
              </Grid>

              <!-- Porta da impressora (modo USB): Automático, ou escolha manual USB/COM -->
              <StackPanel Margin="0,12,0,0"
                          Visibility="{Binding ShowUsbPortSelector, Converter={StaticResource BoolVis}}">
                <TextBlock Text="Porta (deixe Automático; escolha só se souber a porta)" FontSize="11"
                           Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                <ComboBox ItemsSource="{Binding UsbPorts}" SelectedItem="{Binding SelectedUsbPort}">
                  <ComboBox.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding DisplayName}" FontSize="13"/>
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </StackPanel>

              <!-- Campos de Rede -->
              <Grid Margin="0,12,0,0"
                    Visibility="{Binding ShowNetworkFields, Converter={StaticResource BoolVis}}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="12"/>
                  <ColumnDefinition Width="100"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                  <TextBlock Text="Endereço IP" FontSize="11"
                             Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                  <TextBox Text="{Binding IpAddress, UpdateSourceTrigger=PropertyChanged}"
                           Tag="Ex: 192.168.1.100"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <TextBlock Text="Porta" FontSize="11"
                             Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                  <TextBox Text="{Binding NetworkPort, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
              </Grid>

              <!-- Campos Serial -->
              <StackPanel Margin="0,12,0,0"
                          Visibility="{Binding ShowSerialFields, Converter={StaticResource BoolVis}}">
                <TextBlock Text="Porta Serial" FontSize="11"
                           Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                <ComboBox ItemsSource="{Binding ComPorts}" SelectedItem="{Binding SelectedComPort}">
                  <ComboBox.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding DisplayName}" FontSize="13"/>
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </StackPanel>

              <!-- Campos Compartilhada -->
              <StackPanel Margin="0,12,0,0"
                          Visibility="{Binding ShowSharedFields, Converter={StaticResource BoolVis}}">
                <TextBlock Text="Computador ou IP do host" FontSize="11"
                           Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <TextBox Grid.Column="0"
                           Text="{Binding SharedHost, UpdateSourceTrigger=PropertyChanged}"
                           Tag="Ex: DESKTOP-PC ou 192.168.1.50"/>
                  <Button Grid.Column="2"
                          Command="{Binding SearchSharedPrintersCommand}"
                          IsEnabled="{Binding IsSearchingShared, Converter={StaticResource InvertBool}}"
                          Padding="12,0" Height="34">
                    <Button.Style>
                      <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                        <Setter Property="Content" Value="🔍 Buscar"/>
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsSearchingShared}" Value="True">
                            <Setter Property="Content" Value="Buscando..."/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Button.Style>
                  </Button>
                </Grid>

                <!-- Seleção do compartilhamento descoberto ou entrada manual -->
                <TextBlock FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,10,0,4"
                           Text="Impressora encontrada — selecione e clique em Instalar"
                           Visibility="{Binding HasSharedPrinters, Converter={StaticResource BoolVis}}"/>
                <TextBlock FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,10,0,4"
                           Text="Nome do compartilhamento — digite manualmente se souber"
                           Visibility="{Binding HasSharedPrinters, Converter={StaticResource InvertVis}}"/>

                <!-- ComboBox não-editável quando há impressoras descobertas -->
                <ComboBox ItemsSource="{Binding SharedPrinterList}"
                          SelectedItem="{Binding SelectedSharedPrinter, Mode=TwoWay}"
                          FontSize="13"
                          Visibility="{Binding HasSharedPrinters, Converter={StaticResource BoolVis}}"/>

                <!-- TextBox para entrada manual quando nenhuma foi descoberta -->
                <Grid Visibility="{Binding HasSharedPrinters, Converter={StaticResource InvertVis}}">
                  <TextBox Text="{Binding SharedPrinterName, UpdateSourceTrigger=PropertyChanged}"
                           FontSize="13"/>
                  <TextBlock Text="Ex: IMPRESSORA ou HP_LaserJet"
                             Foreground="{StaticResource TextMutedBrush}"
                             FontSize="13" Margin="12,0,0,0"
                             VerticalAlignment="Center" IsHitTestVisible="False">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding SharedPrinterName}" Value="">
                            <Setter Property="Visibility" Value="Visible"/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                </Grid>
                <TextBlock FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                           Margin="0,4,0,0" TextWrapping="Wrap"
                           Visibility="{Binding HasSharedPrinters, Converter={StaticResource InvertVis}}"
                           Text="Clique em 'Buscar' para encontrar automaticamente, ou insira o nome do compartilhamento."/>
              </StackPanel>
              </StackPanel>

              <!-- Divisor fino entre seções -->
              <Border Height="1" Background="{StaticResource BorderBrush2}" Margin="0,18,0,18"/>

              <!-- ── Seção: Configurações ── -->
              <TextBlock Text="CONFIGURAÇÕES DA IMPRESSORA" FontSize="11" FontWeight="SemiBold"
                         Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,10"
                         Typography.Capitals="AllSmallCaps"/>

              <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="12"/>
                  <ColumnDefinition Width="132"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0">
                    <TextBlock Text="Nome da impressora" FontSize="11"
                               Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding PrinterName, UpdateSourceTrigger=PropertyChanged}"/>
                  </StackPanel>
                  <StackPanel Grid.Column="2">
                    <TextBlock Text="Tamanho do papel" FontSize="11"
                               Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding Papers}" SelectedItem="{Binding SelectedPaper}">
                      <ComboBox.ItemTemplate>
                        <DataTemplate>
                          <TextBlock Text="{Binding DisplayName}" FontSize="13"/>
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                  </StackPanel>
                </Grid>

                <Border Grid.Column="2" Style="{StaticResource InfoHint}">
                  <StackPanel>
                    <TextBlock Text="ℹ" FontSize="14" Foreground="#4DCF9E"/>
                    <TextBlock Text="Você poderá alterar essas configurações depois nas preferências."
                               FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                               TextWrapping="Wrap" Margin="0,5,0,0"/>
                  </StackPanel>
                </Border>
              </Grid>

              <CheckBox IsChecked="{Binding SetAsDefault}">
                <StackPanel Margin="4,0,0,0">
                  <TextBlock Text="Definir como impressora padrão no Windows"
                             FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"/>
                  <TextBlock Text="A impressora será usada como padrão para todos os sistemas."
                             FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                             Margin="0,2,0,0"/>
                </StackPanel>
              </CheckBox>
              </StackPanel>

            </StackPanel>
          </Border>

          <!-- Botão Instalar -->
          <Button Style="{StaticResource PillButton}"
                  Command="{Binding InstallCommand}"
                  Height="46" FontSize="14" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="🖨" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"
                         Visibility="{Binding IsInstalling, Converter={StaticResource InvertVis}}"/>
              <TextBlock Text="⏳" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"
                         Visibility="{Binding IsInstalling, Converter={StaticResource BoolVis}}"/>
              <TextBlock Text="Instalar Impressora" FontSize="14" VerticalAlignment="Center"
                         Visibility="{Binding IsInstalling, Converter={StaticResource InvertVis}}"/>
              <TextBlock Text="Instalando..." FontSize="14" VerticalAlignment="Center"
                         Visibility="{Binding IsInstalling, Converter={StaticResource BoolVis}}"/>
            </StackPanel>
          </Button>

          <!-- Status -->
          <Border Padding="14,11" CornerRadius="8"
                  Background="#0CFFFFFF" BorderThickness="1"
                  BorderBrush="{StaticResource BorderBrush2}">
            <!-- Grid instead of a horizontal StackPanel: a horizontal StackPanel gives its
                 children infinite available width, so TextWrapping="Wrap" never actually
                 wrapped — long diagnostic messages (USB device lists, error details) were
                 silently clipped at the window's right edge instead of wrapping. The "*"
                 column here gives the text real width to wrap against. -->
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="⏳" FontSize="13" Margin="0,0,8,0"
                         Foreground="{StaticResource TextMutedBrush}"
                         Visibility="{Binding IsInstalling, Converter={StaticResource BoolVis}}"
                         VerticalAlignment="Top"/>
              <TextBlock Grid.Column="0" Text="✔" FontSize="13" Margin="0,0,8,0"
                         Foreground="{StaticResource SuccessBrush}"
                         Visibility="{Binding ShowSuccess, Converter={StaticResource BoolVis}}"
                         VerticalAlignment="Top"/>
              <TextBlock Grid.Column="0" Text="✖" FontSize="13" Margin="0,0,8,0"
                         Foreground="{StaticResource ErrorBrush}"
                         Visibility="{Binding ShowError, Converter={StaticResource BoolVis}}"
                         VerticalAlignment="Top"/>
              <!-- Read-only TextBox (not TextBlock): lets the user select and copy the full
                   message — including long diagnostic text — with Ctrl+C. Styled borderless/
                   transparent so it looks identical to a label. -->
              <TextBox Grid.Column="1" Text="{Binding StatusText, Mode=OneWay}"
                       FontSize="12" TextWrapping="Wrap"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       Background="Transparent" BorderThickness="0"
                       IsReadOnly="True" IsReadOnlyCaretVisible="True"
                       VerticalAlignment="Center"
                       MaxHeight="260" VerticalScrollBarVisibility="Auto"
                       Padding="0"/>
            </Grid>
          </Border>

        </StackPanel>
      </ScrollViewer>
    </DockPanel>
  </Border>
</Window>
