;
;	Printer Installation File
;
;	 List of supported printers, manufacturers
;

[Version]
Signature="$Windows NT$"
Provider=%GAPrinter300DPIv1%
ClassGUID={4D36E979-E325-11CE-BFC1-08002BE10318}
Class=Printer
CatalogFile=GAPrinter300DPIv1x64.cat
DriverVer=08/09/2010,4.0.1.0

;
; Manufacturer section.
;
; This section lists all of the manufacturers
; that we will display in the Dialog box
;

[Manufacturer]
"GAPrinter300DPIv1"=GAPrinter300DPIv1, NTamd64

;
; Model Specifications Section
;

[GAPrinter300DPIv1]

"GA-F300 Series"                      = GAF300.GPD
"GA-U3 Series"                      = GAU3.GPD

[GAPrinter300DPIv1.NTamd64]

"GA-F300 Series"                      = GAF300.GPD
"GA-U3 Series"                      = GAU3.GPD

;
; Installer section(s) referenced above.
;


[GAF300.GPD]
CopyFiles=@GAPrinter300DPIv1.dll,@GAF300.GPD,@GOEMUNI.INI,GOEMUNI
DataSection=UNIDRV_DATA
DataFile=GAF300.GPD
Include=NTPRINT.INF
Needs=UNIDRV.OEM


[GAU3.GPD]
CopyFiles=@GAPrinter300DPIv1.dll,@GAU3.GPD,@GOEMUNI.INI,GOEMUNI
DataSection=UNIDRV_DATA
DataFile=GAU3.GPD
Include=NTPRINT.INF
Needs=UNIDRV.OEM

[GOEMUNI]
GOEMUNI.DLL

[DestinationDirs]
DefaultDestDir=66000

[SourceDisksNames.amd64]
1 = %disk1%,,,

[SourceDisksFiles]
GAPrinter300DPIv1.DLL                = 1
GOEMUNI.DLL                    = 1
GOEMUNI.INI                     = 1
GAF300.GPD                    = 1
GAU3.GPD                    = 1

[Strings]
PrinterClassName="Printers"
disk1="Printer Driver Setup Disk"
