[Version]
Signature   = "$Windows NT$"
Class       = Printer
ClassGUID   = {4D36E979-E325-11CE-BFC1-08002BE10318}
Provider    = %Mfg%
CatalogFile = EPST82X.cat
DriverVer   = 01/01/2024,1.0.0.0

[Manufacturer]
%Mfg% = Models,NTamd64

[Models.NTamd64]
%PrinterName% = INSTALL_SECTION, USB\VID_04B8&PID_0218
%PrinterName% = INSTALL_SECTION, USBPRINT\VID_04B8&PID_0218

[INSTALL_SECTION]
CopyFiles = @EPST82X.dll

[INSTALL_SECTION.HW]
AddReg = HardwareDeviceSettings

[HardwareDeviceSettings]
HKR,,"BusType",0x00010001,1

[INSTALL_SECTION.Services]
AddService = usbprint,0x00000002,usbprint_service_inst

[usbprint_service_inst]
ServiceType   = 1
StartType     = 3
ErrorControl  = 1
ServiceBinary = %12%\usbprint.sys

[SourceDisksNames]
1 = %DiskName%,,,"."

[SourceDisksFiles]
EPST82X.dll = 1

[DestinationDirs]
DefaultDestDir = 11

[Strings]
Mfg         = "EPSON"
PrinterName = "EPSON TM-T82X"
DiskName    = "Driver Disk"

; =============================================================================
; FIM DO TEMPLATE
; Substitua pelo driver oficial do fabricante.
; =============================================================================
