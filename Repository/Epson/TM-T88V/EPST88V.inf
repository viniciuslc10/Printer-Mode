; Fabricante : EPSON
; Modelo     : TM-T88V
; Driver     : EPSON TM-T88V
; VID/PID    : USB\VID_04B8&PID_0202
;
; ATENÇÃO: Este arquivo é apenas um TEMPLATE estrutural.
; Substitua-o pelo arquivo .INF OFICIAL do fabricante.
; Veja README.txt para instruções de onde baixar o driver real.
; =============================================================================

[Version]
Signature   = "$Windows NT$"
Class       = Printer
ClassGUID   = {4D36E979-E325-11CE-BFC1-08002BE10318}
Provider    = %Mfg%
CatalogFile = EPST88V.cat
DriverVer   = 01/01/2024,1.0.0.0

[Manufacturer]
%Mfg% = Models,NTamd64

[Models.NTamd64]
%PrinterName% = INSTALL_SECTION, USB\VID_04B8&PID_0202
%PrinterName% = INSTALL_SECTION, USBPRINT\VID_04B8&PID_0202

[INSTALL_SECTION]
CopyFiles = @EPST88V.dll

[INSTALL_SECTION.HW]
AddReg = HardwareDeviceSettings

[HardwareDeviceSettings]
HKR,,"BusType",0x00010001,1

[INSTALL_SECTION.Services]
AddService = usbprint,0x00000002,usbprint_service_inst

[usbprint_service_inst]
ServiceType   = 1
StartType     = 3
ErrorControl  = 1
ServiceBinary = %12%\usbprint.sys

[SourceDisksNames]
1 = %DiskName%,,,"."

[SourceDisksFiles]
EPST88V.dll = 1

[DestinationDirs]
DefaultDestDir = 11

[Strings]
Mfg         = "EPSON"
PrinterName = "EPSON TM-T88V"
DiskName    = "Driver Disk"

; =============================================================================
; FIM DO TEMPLATE
; Substitua pelo driver oficial do fabricante.
; =============================================================================
