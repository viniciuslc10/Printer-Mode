*GPDSpecVersion: "1.0"
*Include: "StdNames.gpd"
*GPDFileVersion: "1.0"
*GPDFileName: "ME_DRV_T530A.GPD"
*ModelName: "Mecaf T530_A"
*MasterUnits: PAIR(203, 203)
*ResourceDLL: "ME_DRV_T530A.Dll"
*PrinterType: SERIAL
*Feature: Orientation
{
    *rcNameID: =ORIENTATION_DISPLAY
    *DefaultOption: PORTRAIT
    *Option: PORTRAIT
    {
        *rcNameID: =PORTRAIT_DISPLAY
    }
    *Option: LANDSCAPE_CC270
    {
        *rcNameID: =LANDSCAPE_DISPLAY
    }
}
*Feature: InputBin
{
    *rcNameID: =PAPER_SOURCE_DISPLAY
    *DefaultOption: Option1
    *Option: Option1
    {
        *rcNameID: 259
        *OptionID: 259
    }
}
*Feature: Resolution
{
    *rcNameID: =RESOLUTION_DISPLAY
    *DefaultOption: Option1
    *Option: Option1
    {
        *Name: "203 x 203 " =DOTS_PER_INCH
        *DPI: PAIR(203, 203)
        *TextDPI: PAIR(203, 203)
        *PinsPerLogPass: 1
        *PinsPerPhysPass: 1
        *SpotDiameter: 100
        *Command: CmdSendBlockData
       {
	*CallbackID : 2
	*Params : LIST(NumOfDataBytes)
       }
    }

}
*Feature: PaperSize
{
    *rcNameID: =PAPER_SIZE_DISPLAY
    *DefaultOption: Option2
    *Option: Option1
    {
        *rcNameID: 258
        *OptionID: 258
        *PageDimensions: PAIR(608, 4000)
        *PrintableArea: PAIR(576, 4000)
        *PrintableOrigin: PAIR(16, 0)
    }
    *Option: Option2
    {
        *rcNameID: 261
        *OptionID: 261
        *PageDimensions: PAIR(640, 4000)
        *PrintableArea: PAIR(576, 4000)
        *PrintableOrigin: PAIR(32, 0)
    }
    *Option: Option3
    {
        *rcNameID: 262
        *OptionID: 262
        *PageDimensions: PAIR(608, 24000)
        *PrintableArea: PAIR(576, 24000)
        *PrintableOrigin: PAIR(16, 0)
    }
    *Option: Option4
    {
        *rcNameID: 263
        *OptionID: 263
        *PageDimensions: PAIR(640, 24000)
        *PrintableArea: PAIR(576, 24000)
        *PrintableOrigin: PAIR(32, 0)
    }

}
*Feature: Halftone
{
    *rcNameID: =HALFTONING_DISPLAY
    *DefaultOption: HT_PATSIZE_SUPERCELL_M
    *Option: HT_PATSIZE_SUPERCELL_M
    {
        *rcNameID: =HT_SUPERCELL_DISPLAY
    }
    *Option: HT_PATSIZE_AUTO
    {
        *rcNameID: =HT_AUTO_SELECT_DISPLAY
    }
    *Option: HT_PATSIZE_6x6_M
    {
        *rcNameID: =HT_DITHER6X6_DISPLAY
    }
    *Option: HT_PATSIZE_8x8_M
    {
        *rcNameID: =HT_DITHER8X8_DISPLAY
    }
}
*Command: CmdStartDoc
{
	*Order: DOC_SETUP.1
	*CallbackID : 1
}
*Command: CmdEndDoc
{
	*Order: DOC_FINISH.1
	*Cmd: "<1D><00>Z<02><14>"
}
*BadCursorMoveInGrxMode:LIST(X_PORTRAIT,Y_LANDSCAPE)
*RotateCoordinate?: FALSE
*RotateRaster?: FALSE
*RotateFont?: FALSE
*YMoveUnit: 203
*XMoveUnit: 203
*Command: CmdYMoveRelDown
{
	*CallbackID : 3
	*Params : LIST(DestYRel)
}
*Command: CmdEndPage
{
    *Order: PAGE_FINISH.1
    *CallbackID: 4
}

*Command: CmdEndJob
{
    *Order: JOB_FINISH.1
    *CallbackID: 5
}

*Command: CmdXMoveAbsolute { *Cmd : "<1B>$" %l{DestX} }
*CursorXAfterSendBlockData: AT_GRXDATA_END
*CursorYAfterSendBlockData: AUTO_INCREMENT
*CursorXAfterCR: AT_CURSOR_X_ORIGIN
*TextCaps: LIST(TC_OP_CHARACTER,TC_EA_DOUBLE,TC_IA_ABLE,TC_UA_ABLE)
*Command: CmdLF { *Cmd : "<0A>" }
*Command: CmdFF { *Cmd : "<00>" }
*Command: CmdCR { *Cmd : "<00>" }
*EjectPageWithFF?: TRUE
*OutputDataFormat: H_BYTE
*OptimizeLeftBound?: FALSE
*DefaultFont: 1
*DefaultCTT: 1
*switch: Orientation
{
    *case: PORTRAIT
    {
        *DeviceFonts: LIST(1,2,3,4)
    }
    *case: LANDSCAPE_CC270
    {
        *DeviceFonts: LIST()
    }
}

*Command: CmdBoldOn { *Cmd : "<1B>E" }
*Command: CmdBoldOff { *Cmd : "<1B>F" }
*Command: CmdItalicOn { *Cmd : "<1B>4" }
*Command: CmdItalicOff { *Cmd : "<1B>5" }
*Command: CmdUnderlineOn { *Cmd : "<1B>-<01>" }
*Command: CmdUnderlineOff { *Cmd : "<1B>-<00>" }
