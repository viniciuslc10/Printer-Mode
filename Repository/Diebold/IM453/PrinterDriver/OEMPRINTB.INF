;
; Installer section(s) referenced above.
;

[IM433T]
;CopyFiles=@ME_DRV_T230B.GPD,UNIDRV,COMMONFILES
CopyFiles=@ME_DRV_T230B.GPD,COMMONFILES,LegacyLm
DataSection=UNIDRV_DATA
Include=NTPRINT.INF
Needs=UNIDRV.OEM,UNIDRV_DATA
;DataSection=UNIDRV_DATA
DataFile=ME_DRV_T230B.GPD
LanguageMonitor=ME_LM_T530, ME_LM_T530.dll
AddReg=LangMonRegs

[TUP992]
;CopyFiles=@TUP992.GPD,UNIDRV,COMMONFILES
