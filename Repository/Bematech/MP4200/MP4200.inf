[Version]
Signature   = "$Windows NT$"
Class       = Printer
ClassGUID   = {4D36E979-E325-11CE-BFC1-08002BE10318}
Provider    = %Mfg%
CatalogFile = MP4200.cat
DriverVer   = 01/01/2024,1.0.0.0

[Manufacturer]
%Mfg% = Models,NTamd64

[Models.NTamd64]
%PrinterName% = INSTALL_SECTION, USB\VID_0FE6&PID_811E
%PrinterName% = INSTALL_SECTION, USBPRINT\VID_0FE6&PID_811E

[INSTALL_SECTION]
CopyFiles = @MP4200.dll

[INSTALL_SECTION.HW]
AddReg = HardwareDeviceSettings

[HardwareDeviceSettings]
HKR,,"BusType",0x00010001,1

[INSTALL_SECTION.Services]
AddService = usbprint,0x00000002,usbprint_service_inst

[usbprint_service_inst]
ServiceType   = 1
StartType     = 3
ErrorControl  = 1
ServiceBinary = %12%\usbprint.sys

[SourceDisksNames]
1 = %DiskName%,,,"."

[SourceDisksFiles]
MP4200.dll = 1

[DestinationDirs]
DefaultDestDir = 11

[Strings]
Mfg         = "Bematech"
PrinterName = "Bematech MP-4200 TH"
DiskName    = "Driver Disk"

; =============================================================================
; FIM DO TEMPLATE
; Substitua pelo driver oficial do fabricante.
; =============================================================================
