*% Copyright 2015 Bematech International
*% version 1.0
*% History:
*%   02-jul-2015: [Marcelo Pires Adur] Created, based on MP4200TH's file
*%
*% Attention: There's some problem with odd resource ids that makes rendering plug-in not working. Please use even ids.
*%
*% TODO: Make it works with MP-4000 TH reserved commands (on setting paper width).
*%


*GPDSpecVersion: "1.1"
*Include: "StdNames.gpd"
*Include: "ttfsub.gpd"
*GPDFileVersion: "1.1"
*GPDFileName: "MP100STH.GPD"
*ModelName: "Bematech MP-100S TH Printer"
*MasterUnits: PAIR(203, 203)
*ResourceDLL: "BematechMP4K.dll"
*PrinterType: SERIAL

*Feature: Orientation
{
    *rcNameID: =ORIENTATION_DISPLAY
    *DefaultOption: PORTRAIT

    *Option: PORTRAIT
    {
        *rcNameID: =PORTRAIT_DISPLAY
    }

    *Option: LANDSCAPE_CC270
    {
        *rcNameID: =LANDSCAPE_DISPLAY
    }
}

*Feature: InputBin
{
    *rcNameID: =PAPER_SOURCE_DISPLAY
    *DefaultOption: AUTO

    *Option: AUTO
    {
        *rcNameID: =AUTO_DISPLAY
    }
}

*Feature: Resolution
{
    *rcNameID: =RESOLUTION_DISPLAY
    *DefaultOption: OptionNormal
    *Option: OptionNormal
    {
        *rcNameID: 600
		*%*Name: "203 x 203 DPI "
        *DPI: PAIR(203, 203)
        *TextDPI: PAIR(203, 203)
        *PinsPerLogPass: 24
        *PinsPerPhysPass: 24
        *SpotDiameter: 100

        *Command: CmdSendBlockData
        {
            *CallbackID: 0
            *Params: LIST(NumOfDataBytes)
        }
    }
}


*Feature: PaperSize
{
    *rcNameID: =PAPER_SIZE_DISPLAY
    *DefaultOption: LargeOption80

    *Option: Option80
    {
        *rcNameID: 880
        *OptionID: 880
        *MinLeftMargin: 0
        *PageDimensions: PAIR(588, 1200)
        *PrintableArea: PAIR(588, 1200)
        *PrintableOrigin: PAIR(0, 0)
        *CursorOrigin: PAIR(0, 0)


        *Command: CmdSelect
        {
            *Order: DOC_SETUP.2
            *Cmd: ""
        }
    }


    *Option: Option48
    {
        *rcNameID: 850
        *OptionID: 850
        *MinLeftMargin: 0
        *PageDimensions: PAIR(384, 1200)
        *PrintableArea: PAIR(384, 1200)
        *PrintableOrigin: PAIR(0, 0)

        *Command: CmdSelect
        {
            *Order: DOC_SETUP.2
            *Cmd: ""
        }
    }
    *Option: LargeOption48
    {
        *rcNameID: 854
        *OptionID: 854
        *MinLeftMargin: 0
        *PageDimensions: PAIR(384, 2448)
        *PrintableArea: PAIR(384, 2448)
        *PrintableOrigin: PAIR(0, 0)

        *Command: CmdSelect
        {
            *Order: DOC_SETUP.2
            *Cmd: ""
        }
    }

    *Option: LargeOption80
    {
        *rcNameID: 884
        *OptionID: 884
        *MinLeftMargin: 0
        *PageDimensions: PAIR(588, 2448)
        *PrintableArea: PAIR(588, 2448)
        *PrintableOrigin: PAIR(0, 0)

        *Command: CmdSelect
        {
            *Order: DOC_SETUP.2
            *Cmd: ""
        }
    }

    *Option: CUSTOMSIZE
    {
       *rcNameID: =USER_DEFINED_SIZE_DISPLAY
       *MinSize: PAIR(1, 1)
       *MaxSize: PAIR(588, 32000)
       *MaxPrintableWidth: 588
       *MinLeftMargin: 0
       *CenterPrintable?: TRUE
       *CustCursorOriginX: %d{0}
       *CustCursorOriginY: %d{0}
       *CustPrintableOriginX: %d{0}
       *CustPrintableOriginY: %d{0}
       *CustPrintableSizeX: %d{PhysPaperWidth}
       *CustPrintableSizeY: %d{PhysPaperLength}

       *Command: CmdSelect
       {
          *Order: DOC_SETUP.2
          *Cmd: ""
       }
    }
}


*Feature: Halftone
{
    *rcNameID: =HALFTONING_DISPLAY
    *DefaultOption: HT_PATSIZE_SUPERCELL_M

    *Option: HT_PATSIZE_AUTO
    {
        *rcNameID: =HT_AUTO_SELECT_DISPLAY
    }

    *Option: HT_PATSIZE_SUPERCELL_M
    {
        *rcNameID: =HT_SUPERCELL_DISPLAY
    }

    *Option: HT_PATSIZE_6x6_M
    {
        *rcNameID: =HT_DITHER6X6_DISPLAY
    }

    *Option: HT_PATSIZE_8x8_M
    {
        *rcNameID: =HT_DITHER8X8_DISPLAY
    }
}


*Feature: PaperCut
{
    *Name: "Paper Cut"
    *FeatureType: PRINTER_PROPERTY
    *DefaultOption: PartialCut

    *Option: PartialCut
    {
        *Name: "Cut at Doc End"

        *Command: CmdSelect
        {
            *Order: DOC_FINISH.6
            *Cmd: "<0a><0a><0a><0a><0a><1D><56><01>"

        }
    }

    *Option: PagePartialCut
    {
        *Name: "Cut at Page End"

        *Command: CmdSelect
        {
            *Order: PAGE_FINISH.3
            *CallbackID : 111
        }
    }

    *Option: NoCut
    {
        *Name: "No cut"

        *Command: CmdSelect
        {
            *Order: DOC_FINISH.3
            *Cmd: ""
        }
    }
}


*Feature: CashDrawer
{
    *Name: "Open Cash Drawer (Pin #2)"
    *FeatureType: PRINTER_PROPERTY
    *DefaultOption: OpenDrawerEnd

    *Option: OpenDrawerStart
    {
        *Name: "Before Start"

        *Command: CmdSelect
        {
           *Order: DOC_SETUP.3
           *Cmd: "<1B><70><00><33><33>"
        }
    }

    *Option: OpenDrawerEnd
    {
        *Name: "After End"

        *Command: CmdSelect
        {
            *Order: DOC_FINISH.2
           *Cmd: "<1B><70><00><33><33>"
        }
    }

    *Option: NoDrawer
    {
        *Name: "Never"

        *Command: CmdSelect
        {
            *Order: DOC_FINISH.2
            *Cmd: ""
        }
    }
}

*Feature: CashDrawer2
{
    *Name: "Open Second Cash Drawer (Pin #5)"
    *FeatureType: PRINTER_PROPERTY
    *DefaultOption: NoDrawer2

    *Option: OpenDrawer2Start
    {
        *Name: "Before Start"

        *Command: CmdSelect
        {
           *Order: DOC_SETUP.3
           *Cmd: "<1B><70><01><33><33>"
        }
    }

    *Option: OpenDrawer2End
    {
        *Name: "After End"

        *Command: CmdSelect
        {
            *Order: DOC_FINISH.5
           *Cmd: "<1B><70><01><33><33>"
        }
    }

    *Option: NoDrawer2
    {
        *Name: "Never"

        *Command: CmdSelect
        {
            *Order: DOC_FINISH.2
            *Cmd: ""
        }
    }
}


*Feature: BuzzerOn
{
    *Name: "Buzzer On Time"
    *FeatureType: PRINTER_PROPERTY
    *DefaultOption: BuzzerOn100

    *Option: BuzzerOn100
    {
        *Name: "100 ms"

        *Command: CmdSelect
        {
            *Order: DOC_SETUP.3
	*CallbackID : 106
        }
    }
}

*Feature: BuzzerOff
{
    *Name: "Buzzer Off Time"
    *FeatureType: PRINTER_PROPERTY
    *DefaultOption: BuzzerOff100

    *Option: BuzzerOff100
    {
        *Name: "100 ms"

        *Command: CmdSelect
        {
            *Order: DOC_SETUP.3
			*CallbackID : 107
        }
    }
}

*Feature: BuzzerRepeat
{
    *Name: "Buzzer Repeat"
    *FeatureType: PRINTER_PROPERTY
    *DefaultOption: BuzzerRepeat1

    *Option: BuzzerRepeat1
    {
        *Name: "1x"

